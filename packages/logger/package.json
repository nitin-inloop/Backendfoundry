{
  "name": "@backendfoundry/logger",
  "version": "1.0.0",
  "description": "Structured JSON logging with Node.js AsyncLocalStorage request-context propagation, automatic sensitive-field redaction, pluggable transports, and HTTP duration middleware.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "logger",
    "logging",
    "structured-logging",
    "async-local-storage",
    "redaction"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/logger",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/logger"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only logger",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*",
    "@backendfoundry/errors": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@backendfoundry/health",
  "version": "1.0.0",
  "description": "Kubernetes/cloud-ready liveness and readiness checks with custom dependency probes, strict per-probe timeouts, and credential-sanitized JSON output.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "health-check",
    "readiness",
    "liveness",
    "kubernetes",
    "probes"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/health",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/health"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only health",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/errors": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

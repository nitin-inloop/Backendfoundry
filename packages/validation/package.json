{
  "name": "@backendfoundry/validation",
  "version": "1.0.0",
  "description": "Typed schema validation for request bodies, query strings, and route parameters with built-in fluent validators, external Zod compatibility, and automatic sensitive-field redaction.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "validation",
    "schema",
    "zod",
    "request-validation",
    "express",
    "fastify"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/validation",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/validation"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only validation",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "backendfoundry-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BackendFoundry — Modular Open-Source TypeScript Backend Component Ecosystem",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:cli": "node --test packages/cli/test/index.test.mjs",
    "test:integration": "node --test tests/ecosystem.integration.test.mjs",
    "lint": "node scripts/lint-check.mjs",
    "typecheck": "node scripts/lint-check.mjs --typecheck",
    "validate:registry": "node scripts/validate-registry.mjs",
    "check": "node scripts/build-packages.mjs && node scripts/lint-check.mjs --typecheck && node scripts/run-tests.mjs",
    "cli": "node packages/cli/dist/index.cjs",
    "dev:docs": "pnpm --filter @backendfoundry/docs dev",
    "build:docs": "pnpm --filter @backendfoundry/docs build"
  },
  "devDependencies": {
    "@backendfoundry/ai": "workspace:*",
    "@backendfoundry/cache": "workspace:*",
    "@backendfoundry/circuit-breaker": "workspace:*",
    "@backendfoundry/cli": "workspace:*",
    "@backendfoundry/core": "workspace:*",
    "@backendfoundry/errors": "workspace:*",
    "@backendfoundry/health": "workspace:*",
    "@backendfoundry/idempotency": "workspace:*",
    "@backendfoundry/logger": "workspace:*",
    "@backendfoundry/rate-limit": "workspace:*",
    "@backendfoundry/retry": "workspace:*",
    "@backendfoundry/validation": "workspace:*",
    "@backendfoundry/webhooks": "workspace:*",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}

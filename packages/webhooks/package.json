{
  "name": "@backendfoundry/webhooks",
  "version": "1.0.0",
  "description": "HMAC-SHA256 webhook signing, constant-time signature verification, timestamp replay-window enforcement, zero-downtime secret rotation, and event deduplication.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "webhooks",
    "hmac",
    "signature",
    "verification",
    "security"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/webhooks",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/webhooks"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only webhooks",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@backendfoundry/ai",
  "version": "1.0.0",
  "description": "Unified LLM provider interface with structured schema output validation, streaming chunks, per-attempt timeouts, retry/fallback orchestration, and token accounting.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "ai",
    "llm",
    "openai",
    "fallback",
    "structured-output"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/ai",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/ai"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only ai",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*",
    "@backendfoundry/validation": "workspace:*",
    "@backendfoundry/retry": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@backendfoundry/retry",
  "version": "1.0.0",
  "description": "Explicit retry policies with exponential backoff, full/equal jitter, retry predicates, per-attempt timeouts, AbortSignal cancellation, and attempt telemetry.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "retry",
    "backoff",
    "exponential-backoff",
    "jitter",
    "resilience"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/retry",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/retry"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only retry",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*",
    "@backendfoundry/errors": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

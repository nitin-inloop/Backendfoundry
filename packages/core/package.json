{
  "name": "@backendfoundry/core",
  "version": "1.0.0",
  "description": "Shared TypeScript types, FoundryError base class, request ID generation/validation, standard API response envelopes, and secret-safe environment variable parsers.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "request-id",
    "api-response",
    "env",
    "errors",
    "typescript"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/core",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only core",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}

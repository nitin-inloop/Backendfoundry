{
  "name": "@backendfoundry/idempotency",
  "version": "1.0.0",
  "description": "Atomic idempotency key locking, canonical SHA-256 request payload fingerprinting, stored response replay, and concurrent conflict protection.",
  "keywords": [
    "backendfoundry",
    "backend",
    "nodejs",
    "typescript",
    "idempotency",
    "idempotency-key",
    "payments",
    "deduplication"
  ],
  "license": "MIT",
  "author": "BackendFoundry Contributors",
  "homepage": "https://backendfoundry.dev/packages/idempotency",
  "bugs": {
    "url": "https://github.com/nitin-inloop/Backendfoundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitin-inloop/Backendfoundry.git",
    "directory": "packages/idempotency"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only idempotency",
    "test": "node --test test/index.test.mjs"
  },
  "dependencies": {
    "@backendfoundry/core": "workspace:*",
    "@backendfoundry/errors": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^5.4.1"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
